{
	"name": "keta-academy-frontend",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "pnpm dlx @biomejs/biome check --write --css-parse-tailwind-directives=true",
		"lint:check": "biome check --css-parse-tailwind-directives=true",
		"typecheck": "tsc --noEmit",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched --css-parse-tailwind-directives=true"
		]
	},
	"dependencies": {
		"@next/third-parties": "^16.4.6",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-progress": "^1.2.1",
		"@radix-ui/react-radio-group": "^1.5.1",
		"@radix-ui/react-scroll-area": "^1.4.0",
		"@radix-ui/react-select": "^2.4.1",
		"@radix-ui/react-separator": "^1.2.0",
		"@radix-ui/react-slot": "^1.5.0",
		"@strapi/blocks-react-renderer": "^1.0.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.82.0",
		"motion": "^14.14.0",
		"next": "16.4.6",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.1",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^26",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@typescript/native-preview": "npm:typescript@^7.0.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.2",
		"postcss": "^8.5.34",
		"tailwindcss": "^4",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@12.23.0"
